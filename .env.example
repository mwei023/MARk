
# Database
DB_PASSWORD=***
DATABASE_URL=postgres://mwei:***@localhost:5433/jarvis_memory

# LLM Provider Configuration
# Set the primary provider: groq, gemini, openrouter, or ollama
LLM_PROVIDER=groq

# Optional: Specify fallback providers (comma-separated, in order of preference)
# Default: gemini,openrouter,ollama
LLM_FALLBACK_PROVIDERS=openrouter,ollama

# Groq Configuration
GROQ_API_KEY=***
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini Configuration
GEMINI_API_KEY=***
GEMINI_MODEL=gemini-3.1-pro-preview

# OpenRouter Configuration
OPENROUTER_API_KEY=***
OPENROUTER_MODEL=openrouter/free

# Ollama Configuration (for local/fallback inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Security
ALLOWED_DATA_DIR=/home/mwei/data
JWT_SECRET=your_jwt_secret_here

# API exposure (see app/src/api/security.ts)
# Localhost-only by default. The server binds 127.0.0.1 unless API_BIND_HOST
# is set explicitly (e.g. 0.0.0.0 on a trusted network) and refuses to boot
# in production (NODE_ENV=production) with an open API.
API_TOKEN=your_long_random_token_here
API_BIND_HOST=127.0.0.1
# Escape hatch for trusted networks only — never the default:
#MARK_ALLOW_UNAUTHENTICATED_API=true
# Require HMAC signatures on inbound GitHub webhooks:
#GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# MARK routing brain (Jev System One decisions; optional, degrades cleanly)
# Get a key at https://jevtypesafeai.com/pricing (or point JEV_ENDPOINT at
# https://api.typesafe.ai/v1/systemone with a TypeSafe key)
#JEV_API_KEY=jv_live_...
#JEV_ENDPOINT=https://jevtypesafeai.com/api/v1/decide

# MARK runtime behaviour (Phase 0 centralised config)
MARK_DEFAULT_USER=mark
MARK_SMART=on
MARK_ENABLE_AUTOFIX=false
MARK_DRY_RUN=false
MARK_LEARNING=true
