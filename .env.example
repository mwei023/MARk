
# Database
DB_PASSWORD=***
DATABASE_URL=postgres://mwei:***@localhost:5433/jarvis_memory

# LLM Provider Configuration
# Set the primary provider: groq, gemini, openrouter, or ollama
LLM_PROVIDER=groq

# Optional: Specify fallback providers (comma-separated, in order of preference)
# Default: gemini,openrouter,ollama
LLM_FALLBACK_PROVIDERS=openrouter,ollama

# Groq Configuration
GROQ_API_KEY=***
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini Configuration
GEMINI_API_KEY=***
GEMINI_MODEL=gemini-3.1-pro-preview

# OpenRouter Configuration
OPENROUTER_API_KEY=***
OPENROUTER_MODEL=openrouter/free

# Ollama Configuration (for local/fallback inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Security
ALLOWED_DATA_DIR=/home/mwei/data
JWT_SECRET=your_jwt_secret_here
