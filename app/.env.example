# MARK — Environment Configuration
# Copy this file to .env and fill in your values.
# All keys are optional unless marked REQUIRED.

# ─── Identity ──────────────────────────────────────────────────────────────────
# Default user id for CLI / REPL sessions.
MARK_DEFAULT_USER=mark

# ─── Database ──────────────────────────────────────────────────────────────────
# REQUIRED for incident store, workflow memory, and confirmations.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://mark:changeme@localhost:5432/mark_db

# ─── API Server ────────────────────────────────────────────────────────────────
# Port for the HTTP REST API. Default: 3000.
API_PORT=3000

# Bearer token required for API requests. Unset = no auth (dev only).
# API_TOKEN=your-secret-token

# Shared secret for verifying GitHub webhook signatures (X-Hub-Signature-256).
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Primary provider: ollama | openrouter | groq | gemini
LLM_PROVIDER=ollama

# Comma-separated fallback chain when primary is unavailable.
# LLM_FALLBACK_PROVIDERS=groq,openrouter

# Inference timeout in milliseconds. Default: 30000.
# MARK_LLM_TIMEOUT_MS=30000

# ─── Ollama (default provider) ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── OpenRouter ────────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Groq ──────────────────────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama3-8b-8192

# ─── Gemini ────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# ─── Runtime Behaviour ─────────────────────────────────────────────────────────
# Set to 'off' to disable LLM-assisted routing (faster, offline-safe, test-stable).
# MARK_SMART=off

# Set to 'true' to log all mutating actions as WOULD HAVE without executing.
# Safe to enable in staging or demo environments.
# MARK_DRY_RUN=false

# Set to 'true' to allow low-risk auto-fix actions (npm install, lint:fix)
# without manual approval. Off by default — do not enable on shared hosts.
# MARK_ENABLE_AUTOFIX=false

# Set to 'false' to disable workflow memory learning (do not save new workflows).
# MARK_LEARNING=true

# Set to 'true' to auto-trust tools after the first successful confirmation.
# MARK_AUTO_TRUST=false

# ─── Security ──────────────────────────────────────────────────────────────────
# Root directory shell capabilities are allowed to read/write.
# Defaults to /tmp/mark-data (safe). Set to your actual data directory.
ALLOWED_DATA_DIR=/home/mark/data

# ─── Voice (optional) ──────────────────────────────────────────────────────────
# WHISPER_BIN=/path/to/whisper-cli
# WHISPER_MODEL=/path/to/ggml-small.en.bin
# PIPER_BIN=piper
# PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
# LD_LIBRARY_PATH=/path/to/whisper/libs
